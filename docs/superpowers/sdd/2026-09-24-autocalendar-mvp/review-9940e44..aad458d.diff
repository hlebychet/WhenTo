+                OutlinedTextField(
+                    value = location ?: "",
+                    onValueChange = { viewModel.onLocationChange(it.ifBlank { null }) },
+                    modifier = Modifier.fillMaxWidth(),
+                    label = { Text("Location (optional)") },
+                    singleLine = true,
